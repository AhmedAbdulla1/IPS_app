# This file was generated using idf.py save-defconfig or menuconfig [D] key. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.5.5 Project Minimal Configuration
#

#
# Serial flasher config
#
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# partition table مخصص (2MB factory app) - نفس سبب IPS_Mesh_Node (mesh_lite +
# wifi_provisioning/protocomm/mbedtls أكبر من 1MB الافتراضي). الفلاش 4MB
# فمفيش مشكلة في المساحة.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# إصلاح بعد crash حقيقي وقت الاختبار على الروت (stack overflow
# في "Tmr Svc" task) - الافتراضي (2048) مش كافي مع حمل mesh_lite/OTA
# وقت البدء.
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096

# STA interface ضرورية عشان mesh_lite يشتغل (scan/election) حتى لو
# الشبكة معزولة عن الإنترنت. مفيش خطر اتصال بروتر خارجي لأن
# CONFIG_BRIDGE_STATION_CANCEL_AUTO_CONNECT_WHEN_DISCONNECTED مفعّل.
CONFIG_BRIDGE_EXTERNAL_NETIF_STATION=y
# end of Serial flasher config

#
# Component config
#

#
# ESP Wi-Fi Mesh Lite
#
CONFIG_MESH_LITE_ENABLE=y

#
# Mesh-Lite info configuration
#
CONFIG_MESH_LITE_VENDOR_ID_0=71
CONFIG_MESH_LITE_VENDOR_ID_1=87
CONFIG_MESH_LITE_ID=77
CONFIG_MESH_LITE_MAX_ROUTER_NUMBER=3
CONFIG_MESH_LITE_MAXIMUM_LEVEL_ALLOWED=10
CONFIG_DEVICE_CATEGORY="ESP32"
# end of Mesh-Lite info configuration

CONFIG_JOIN_MESH_WITHOUT_CONFIGURED_WIFI_INFO=y
CONFIG_JOIN_MESH_IGNORE_ROUTER_STATUS=y
CONFIG_ESP_MESH_LITE_OTA_ENABLE=y

# --- تشخيص مؤقت (2026-09-12): الNode مش بيقدر يلاقي/يتصل بالRoot
# رغم تطابق الconfig كاملاً - فعّلنا لوج mesh_lite التفصيلي عشان
# نشوف مرحلة الفشل بالظبط. لازم يتشال بعد ما نحل المشكلة.
# NODE_INFO_REPORT مش مفعّل - بيسبّب IRAM overflow مع WIRELESS_DEBUG في
# الNode (نفس المكوّنات، محتمل يحصل هنا كمان). WIRELESS_DEBUG
# لوحده كافي للتشخيص الحالي.
CONFIG_MESH_LITE_WIRELESS_DEBUG=y
# end of ESP Wi-Fi Mesh Lite
# end of Component config
