# طريقة الاتصال: tcp (عبر شبكة الـWi-Fi) أو serial (عبر كابل USB)
CONNECTION_MODE=tcp
ROOT_HOST=192.168.5.1
ROOT_PORT=9998

# إعدادات منفذ الـSerial (في حال تم اختيار CONNECTION_MODE=serial)
SERIAL_PORT=COM5
BAUD_RATE=115200

SUPABASE_URL=https://dqnmxlljqiqgqmntzvcx.supabase.co
