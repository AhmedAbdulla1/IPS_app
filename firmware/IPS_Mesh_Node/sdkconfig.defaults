# إعدادات SDK افتراضية لـIPS_Mesh_Node.
# مصدر القيم: توثيق "Arduino as an ESP-IDF component" الرسمي بيوصي
# بـFreeRTOS tick rate = 1000Hz لتوافق أفضل مع مكتبات Arduino timing.
CONFIG_FREERTOS_HZ=1000

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

