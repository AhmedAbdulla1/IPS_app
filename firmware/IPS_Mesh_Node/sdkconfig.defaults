# إعدادات SDK لـIPS_Mesh_Node - ESP-IDF native (بدون Arduino من دلوقتي).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# partition table مخصص (2MB factory app) - الافتراضي (1MB) مش كافي
# لحجم mesh_lite + NimBLE مع بعض (~1.04MB فعليًا). الفلاش 4MB
# فمفيش مشكلة في المساحة.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# دعم OTA بأمان: لو فيرموير جديد متحدّث كرش (crash loop)، البوتلودر
# يرجع تلقائيًا للنسخة القديمة المستقرة (راجع OTA_PLAN.md). الأبليكيشن
# لازم تنادي esp_ota_mark_app_valid_cancel_rollback() بعد التأكد إنه
# شغال كويس (موجودة في app_main).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# إصلاح بعد crash حقيقي ظهر في اختبار IPS_Mesh_Root (نفس mesh_lite/
# iot_bridge موجودين هنا كمان) - stack overflow في "Tmr Svc" task.
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096

# STA interface ضرورية عشان mesh_lite يقدر يعمل WiFi scan ويلاقي
# الـparent node. من غيرها، الـwifi بيشتغل AP-only ومش بيقدر يسكان.
# مفيش خطر اتصال بروتر خارجي لأن مفيش credentials محفوظة +
# CONFIG_BRIDGE_STATION_CANCEL_AUTO_CONNECT_WHEN_DISCONNECTED مفعّل.
CONFIG_BRIDGE_EXTERNAL_NETIF_STATION=y

CONFIG_JOIN_MESH_WITHOUT_CONFIGURED_WIFI_INFO=y
CONFIG_JOIN_MESH_IGNORE_ROUTER_STATUS=y

# --- إعدادات LwIP الأساسية للـ Multi-hop Routing ---
# حرج جداً: بدون IP Forwarding و NAPT، النود الوسيطة لا تستطيع تمرير
# حزم البيانات والـ Heartbeats من النودز التابعة لها إلى الروت!
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y

# إضافة الـ MAC لاسم SoftAP لمنع تصادم الـ BSSID بين النودز
CONFIG_BRIDGE_SOFTAP_SSID_END_WITH_THE_MAC=y

# تفعيل OTA عبر الميش لاستقبال التحديثات من الروت
CONFIG_ESP_MESH_LITE_OTA_ENABLE=y


# --- BLE stack: NimBLE بدل Bluedroid (أخف وأنسب لـadvertising بسيط) ---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n

# ملحوظة (BLE/WiFi coexistence - راجع MESH_PROGRESS.md):
# اتأكد فعليًا من محتوى sdkconfig المتولّد إن CONFIG_ESP_COEX_ENABLED=y
# وCONFIG_ESP_COEX_SW_COEXIST_ENABLE=y مفعّلين تلقائيًا بمجرد وجود
# مكوّني bt وesp_wifi في نفس البناء - مفيش داعي لإضافة config يدوي هنا.
# لسه محتاج اختبار ميداني فعلي: هل BLE advertising بيستقر لما mesh
# traffic يزيد؟ (ده اختبار أداء، مش إعداد ناقص).

# --- تشخيص مؤقت (2026-09-12): الNode مش بيقدر يلاقي/يتصل بالRoot
# رغم تطابق الconfig كاملاً - فعّلنا لوج mesh_lite التفصيلي عشان
# نشوف مرحلة الفشل بالظبط. لازم يتشال بعد ما نحل المشكلة (مش
# جزء من الإعداد النهائي).
# NODE_INFO_REPORT مش مفعّل - كان بيسبّب IRAM overflow (3052 بايت)
# مع WIRELESS_DEBUG مع بعض. WIRELESS_DEBUG لوحده كافي للتشخيص الحالي.
CONFIG_MESH_LITE_WIRELESS_DEBUG=y

# تبيّن إن WIRELESS_DEBUG لوحده (مش NODE_INFO_REPORT) هو المسبّب
# الوحيد لـIRAM overflow (نفس الـ3052 بايت رجعت تاني بعد ما شلنا
# NODE_INFO_REPORT). بدل ما نلغي WIRELESS_DEBUG (اللي محتاجينه للتشخيص)،
# بدّلنا التحسين (optimization) لـ "Size" (-Os) بدل "Debug" (-Og
# الافتراضي) - بيوفر مساحة أكتر بكتير في كل المشروع، مش
# بس الجزء الخاص بالـmesh_lite. مؤقت (تشخيص) زي باقي WIRELESS_DEBUG.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# --- قيم كانت مظبوطة قبل كده عن طريق menuconfig يدوي ومكنتش
# مسجلة هنا - المفروض تمسح الـsdkconfig القديم بعدها (راجع
# MESH_PROGRESS.md - نفس الدرس المستفادة من قبل): لازم تفضل هنا
# صراحة عشان متضيعش تاني لو اتمسح الـsdkconfig المولّد. لازم تتطابق
# حرفيًا مع نفس القيم في IPS_Mesh_Root/sdkconfig.defaults.
#
# ملحوظة حرجة: CONFIG_MESH_LITE_ENABLE=y كان ناقص خالص من الملف ده
# (كان مفعّل بـmenuconfig بس)، فلما kconfgen أعاد البناء من الأول
# من الـdefaults بس، قائمة "Mesh-Lite info configuration" الفرعية كلها
# اختفت من شجرة الـKconfig لأنها بتظهر بس لو CONFIG_MESH_LITE_ENABLE=y -
# عشان كده ظهرت رسائل "undeclared" مش "wrong value".
CONFIG_MESH_LITE_ENABLE=y
CONFIG_MESH_LITE_VENDOR_ID_0=71
CONFIG_MESH_LITE_VENDOR_ID_1=87
CONFIG_MESH_LITE_ID=77
CONFIG_MESH_LITE_MAX_ROUTER_NUMBER=3
CONFIG_MESH_LITE_MAXIMUM_LEVEL_ALLOWED=15
CONFIG_DEVICE_CATEGORY="ESP32"
